{
  "name": "pokerdot-web-frontend",
  "version": "0.0.1",
  "description": "Web UI for playing PokerDot.",
  "source": [
    "index.html",
    "404.html",
    "logo.png"
  ],
  "scripts": {
    "start": "parcel --port 3000",
    "build": "parcel build",
    "test": "elm-test"
  },
  "devDependencies": {
    "@parcel/optimizer-svgo": "2.16.4",
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/packager-xml": "2.16.4",
    "@parcel/transformer-elm": "^2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
    "@parcel/transformer-xml": "2.16.4",
    "elm": "^0.19.2-0",
    "elm-format": "^0.8.8",
    "elm-test": "^0.19.2-0",
    "parcel": "^2.16.4",
    "parcel-plugin-browserconfig": "^1.0.5",
    "process": "^0.11.10",
    "svgo": "^4.0.1"
  },
  "dependencies": {
    "partysocket": "^1.1.16"
  },
  "//": "elm override: @parcel/transformer-elm's peer range doesn't allow elm 0.19.2 yet; remove when it does",
  "overrides": {
    "@parcel/transformer-elm": {
      "elm": "$elm"
    }
  }
}
